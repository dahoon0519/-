# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: The SOLE authorized administrator Google email address.
# Enforced strictly by the backend server.
ADMIN_EMAIL="dahoon0519@gmail.com"
VITE_ADMIN_EMAIL="dahoon0519@gmail.com"

# GOOGLE_CLIENT_ID: Google Cloud Console OAuth 2.0 Web Client ID.
# Required for Google Identity Services token validation.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# SESSION_SECRET: Cryptographic secret key used to sign HttpOnly session cookies.
# Must be a long random string (at least 32 characters). Server-only, NEVER expose to client.
SESSION_SECRET="your-secure-32-plus-character-secret-key-for-sessions"
